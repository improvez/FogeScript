// Recursão: a senhora chama a si mesma
NÃO, EU NUNCA FIZ ISSO FATORIAL(N)
    SE A SENHORA NÃO É FUNCIONÁRIA (N <= 1)
        CHEGA DE CORRER 1;
    FUGIU
    CHEGA DE CORRER N * CHAMA A SENHORA FATORIAL(N - 1);
FUGIU

A SENHORA TRABALHA NA ASSEMBLEIA?
    SENHORA? SENHORA?! (A SENHORA FEZ I = 1; I <= 10; I++)
        TEMOS GRAVADO!(I + "! =", CHAMA A SENHORA FATORIAL(I));
    FUGIU
FUGIU
